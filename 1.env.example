# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# API-ключ OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Необязательные настройки
# gpt-4o-mini — дешевле, gpt-4o — качественнее (обе поддерживают фото)
OPENAI_MODEL=gpt-4o-mini
MAX_HISTORY_MESSAGES=10
SYSTEM_PROMPT=Ты — дружелюбный ИИ-ассистент в Telegram. Отвечай кратко, по делу и на языке пользователя.
